---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Long-read pages only — on short pages the bar sits near-full and reads as noise. */
  progress?: boolean;
  /** Site-relative path to the social card; generated by src/pages/og/. */
  image?: string;
}

const {
  title,
  description = "Danny Brown — staff-level software engineer. High throughput, low ceremony, and the tooling that keeps it that way.",
  progress = false,
  image = "/og/site.png",
} = Astro.props;

const year = new Date().getUTCFullYear();
const fullTitle = `${title} · dannybrown.dev`;
// Scrapers won't resolve relative URLs, so both of these have to be absolute.
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-pt-20">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/inter-tight-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-serif-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="description" content={description} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Danny Brown"
      href={new URL("rss.xml", Astro.site)}
    />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="dannybrown.dev" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{fullTitle}</title>
    <ClientRouter />
    <!-- Inline and render-blocking on purpose: applying the stored theme after
         first paint would flash the wrong background. That rules out importing
         from src/lib/theme.ts here — Astro would bundle this as a deferred
         module — so the parse/resolve rules are restated by hand; the toggle's
         cycle order, the part that actually changes, stays in the lib.

         The after-swap listener is not redundant: ClientRouter replaces
         <html>'s attributes with the incoming document's, dropping both the
         .dark class and data-theme on every navigation. -->
    <script is:inline>
      (() => {
        const media = matchMedia("(prefers-color-scheme: dark)");
        const apply = () => {
          const stored = localStorage.getItem("theme");
          const theme =
            stored === "light" || stored === "dark" || stored === "system"
              ? stored
              : "system";
          const root = document.documentElement;
          root.dataset.theme = theme;
          root.classList.toggle(
            "dark",
            theme === "system" ? media.matches : theme === "dark",
          );
          document
            .getElementById("theme-toggle")
            ?.setAttribute("aria-label", `Color theme: ${theme}`);
        };
        apply();
        // The button doesn't exist yet on this first pass, so its label gets
        // set on the second — everything else above has already landed.
        document.addEventListener("DOMContentLoaded", apply);
        document.addEventListener("astro:after-swap", apply);
        document.addEventListener("theme:change", apply);
        // Only bites while the setting is "system", where apply() re-resolves.
        media.addEventListener("change", apply);
      })();
    </script>
  </head>
  <body
    class="bg-paper text-ink dark:bg-paper-dk dark:text-ink-dk min-h-screen font-sans antialiased"
  >
    <!-- z-20 clears the sticky header's z-10; without it the link renders
         underneath the thing it exists to skip past. -->
    <a
      href="#main"
      class="bg-paper text-ink dark:bg-paper-dk dark:text-ink-dk border-line dark:border-line-dk sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-20 focus:rounded-md focus:border focus:px-4 focus:py-2 focus:text-sm focus:font-semibold"
    >
      Skip to content
    </a>

    <header
      class="border-line dark:border-line-dk bg-paper/80 dark:bg-paper-dk/80 sticky top-0 z-10 border-b backdrop-blur"
    >
      {
        progress && (
          <div
            class="reading-progress bg-accent dark:bg-accent-dk absolute inset-x-0 -bottom-px h-0.5"
            aria-hidden="true"
          />
        )
      }
      <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
        <!-- Negative margins pull the hit area out into the header's own
             padding without moving the text or changing the row height. -->
        <a
          href="/"
          class="hover:text-accent dark:hover:text-accent-dk -my-4 -ml-6 inline-block py-4 pr-4 pl-6 text-sm font-semibold tracking-tight transition-colors"
        >
          Danny Brown
        </a>
        <nav class="flex items-center gap-6 text-sm">
          <a
            href="/blog"
            class="text-muted dark:text-muted-dk hover:text-ink dark:hover:text-ink-dk -mx-3 -my-4 px-3 py-4 transition-colors"
          >
            Writing
          </a>
          <a
            href="https://github.com/dannybrown37"
            target="_blank"
            rel="noopener"
            class="text-muted dark:text-muted-dk hover:text-ink dark:hover:text-ink-dk -mx-3 -my-4 px-3 py-4 transition-colors"
          >
            GitHub
          </a>
          <button
            id="theme-toggle"
            type="button"
            aria-label="Color theme"
            class="text-muted dark:text-muted-dk hover:text-ink dark:hover:text-ink-dk -my-4 -mr-6 -ml-3 py-4 pr-6 pl-3 transition-colors"
          >
            <svg
              class="theme-icon theme-icon-light h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
              ></path>
            </svg>
            <svg
              class="theme-icon theme-icon-dark h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
            </svg>
            <svg
              class="theme-icon theme-icon-system h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="2.5" y="4" width="19" height="12.5" rx="1.5"></rect>
              <path d="M8.5 20.5h7M12 16.5v4"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <!-- tabindex="-1" so the skip link moves focus here, not just the scroll
         position — <main> isn't focusable on its own. Programmatic focus
         doesn't match :focus-visible, so this stays unringed. -->
    <main id="main" tabindex="-1" class="mx-auto max-w-3xl px-6 pt-14 pb-24">
      <slot />
    </main>

    <footer class="border-line dark:border-line-dk border-t">
      <div
        class="text-muted dark:text-muted-dk mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-3 px-6 py-8 text-sm"
      >
        <p>© {year} Danny Brown</p>
        <div class="flex items-center gap-6">
          <a
            class="hover:text-ink dark:hover:text-ink-dk -mx-3 -my-4 px-3 py-4 transition-colors"
            href="/rss.xml"
          >
            RSS
          </a>
          <a
            class="hover:text-ink dark:hover:text-ink-dk -mx-3 -my-4 px-3 py-4 transition-colors"
            href="https://github.com/dannybrown37"
            target="_blank"
            rel="noopener"
          >
            GitHub
          </a>
          <a
            class="hover:text-ink dark:hover:text-ink-dk -mx-3 -my-4 px-3 py-4 transition-colors"
            href="https://linkedin.com/in/dannybrown37"
            target="_blank"
            rel="noopener"
          >
            LinkedIn
          </a>
          <a
            class="hover:text-ink dark:hover:text-ink-dk -my-4 -mr-6 -ml-3 py-4 pr-6 pl-3 transition-colors"
            href="mailto:tinker@dannybrown.dev"
          >
            Email
          </a>
        </div>
      </div>
    </footer>

    <!-- Delegated from document, which ClientRouter never replaces — binding to
         the button itself would go dead after the first navigation. This only
         advances the stored setting; the head script owns applying it, and
         picks the change up via the event below. -->
    <script>
      import { nextTheme, parseTheme } from "../lib/theme";

      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        if (!target?.closest("#theme-toggle")) return;
        const theme = nextTheme(parseTheme(localStorage.getItem("theme")));
        localStorage.setItem("theme", theme);
        document.dispatchEvent(new Event("theme:change"));
      });
    </script>
  </body>
</html>
