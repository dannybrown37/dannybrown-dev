---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PostRow from "../../../components/PostRow.astro";
import { slugifyTag } from "../../../lib/tag-slug";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const byTag = new Map<string, { label: string; posts: typeof posts }>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugifyTag(tag);
      if (!slug) continue;
      const entry = byTag.get(slug) ?? { label: tag, posts: [] };
      entry.posts.push(post);
      byTag.set(slug, entry);
    }
  }

  return [...byTag].map(([slug, { label, posts }]) => ({
    params: { tag: slug },
    props: {
      label,
      posts: posts.sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
      ),
    },
  }));
}

const { label, posts } = Astro.props;
---

<Layout
  title={`Posts tagged ${label}`}
  description={`Every post tagged ${label}.`}
>
  <a
    class="text-muted dark:text-muted-dk hover:text-ink dark:hover:text-ink-dk text-sm transition-colors"
    href="/blog"
  >
    ← Writing
  </a>
  <h1 class="font-display mt-8 text-3xl sm:text-4xl">
    Tagged <span class="font-mono text-2xl sm:text-3xl">{label}</span>
  </h1>
  <p class="text-muted dark:text-muted-dk mt-4 text-lg">
    {posts.length}
    {posts.length === 1 ? "post" : "posts"}
  </p>

  <ul class="mt-14 space-y-6">
    {
      posts.map((post) => (
        <PostRow
          id={post.id}
          title={post.data.title}
          pubDate={post.data.pubDate}
          description={post.data.description}
          tags={post.data.tags}
        />
      ))
    }
  </ul>
</Layout>
