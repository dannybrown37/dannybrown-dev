---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import TagList from "../../../components/TagList.astro";
import { formatDate } from "../../../lib/format-date";
import { slugifyTag } from "../../../lib/tag-slug";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const byTag = new Map<string, { label: string; posts: typeof posts }>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugifyTag(tag);
      if (!slug) continue;
      const entry = byTag.get(slug) ?? { label: tag, posts: [] };
      entry.posts.push(post);
      byTag.set(slug, entry);
    }
  }

  return [...byTag].map(([slug, { label, posts }]) => ({
    params: { tag: slug },
    props: {
      label,
      posts: posts.sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
      ),
    },
  }));
}

const { label, posts } = Astro.props;
---

<Layout
  title={`Posts tagged ${label}`}
  description={`Every post tagged ${label}.`}
>
  <a
    class="text-muted dark:text-muted-dk hover:text-ink dark:hover:text-ink-dk text-sm transition-colors"
    href="/blog"
  >
    ← Writing
  </a>
  <h1 class="font-display mt-8 text-3xl sm:text-4xl">
    Tagged <span class="font-mono text-2xl sm:text-3xl">{label}</span>
  </h1>
  <p class="text-muted dark:text-muted-dk mt-4 text-lg">
    {posts.length}
    {posts.length === 1 ? "post" : "posts"}
  </p>

  <ul class="mt-14 space-y-10">
    {
      posts.map((post) => (
        <li>
          <p class="text-muted dark:text-muted-dk font-mono text-xs">
            {formatDate(post.data.pubDate)}
          </p>
          <a
            class="hover:text-accent dark:hover:text-accent-dk font-display mt-2 inline-block text-xl transition-colors"
            href={`/blog/${post.id}`}
          >
            {post.data.title}
          </a>
          <p class="text-muted dark:text-muted-dk mt-2 max-w-prose leading-relaxed">
            {post.data.description}
          </p>
          <TagList tags={post.data.tags} class="mt-3" />
        </li>
      ))
    }
  </ul>
</Layout>
