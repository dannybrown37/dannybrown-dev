---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostRow from "../../components/PostRow.astro";
import { groupPostsByYear } from "../../lib/group-posts-by-year";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const years = groupPostsByYear(posts);

// -ml-24 == the 4rem year column plus the 2rem gap, so the year hangs in the
// page margin rather than narrowing the post column.
const yearGridClass = "lg:-ml-24 lg:grid lg:grid-cols-[4rem_1fr] lg:gap-8";
---

<Layout title="Writing">
  <h1 class="font-display text-3xl sm:text-4xl">Writing</h1>
  <p class="text-muted dark:text-muted-dk mt-4 max-w-prose text-lg">
    Notes on whatever I care to write about.
    While I use LLM tooling in my work as a software engineer,
    the writing on this part of the site is 100% artisan and handcrafted.
  </p>

  <div class="mt-14 space-y-14">
    {
      years.map(({ year, posts }) => (
        <section
          aria-labelledby={`year-${year}`}
          class={yearGridClass}
        >
          <h2 id={`year-${year}`} class="border-line dark:border-line-dk mb-6 border-b pb-2 lg:mb-0 lg:border-b-0 lg:pb-0">
            <span class="text-muted dark:text-muted-dk font-mono text-xs tracking-widest lg:sticky lg:top-24 lg:block lg:text-3xl lg:tracking-normal">
              {year}
            </span>
          </h2>
          <ul class="space-y-6">
            {posts.map((post) => (
              <PostRow
                id={post.id}
                title={post.data.title}
                pubDate={post.data.pubDate}
                description={post.data.description}
                tags={post.data.tags}
              />
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>
