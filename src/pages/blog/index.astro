---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import TagList from "../../components/TagList.astro";
import { formatDate } from "../../lib/format-date";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog">
  <h1 class="font-display text-3xl sm:text-4xl">Writing</h1>
  <p class="text-muted dark:text-muted-dk mt-4 max-w-prose text-lg">
    Notes on whatever I care to write about.
  </p>

  <ul class="mt-14 space-y-10">
    {
      posts.map((post) => (
        <li>
          <p class="text-muted dark:text-muted-dk font-mono text-xs">
            {formatDate(post.data.pubDate)}
          </p>
          <a
            transition:name={`post-title-${post.id}`}
            class="hover:text-accent dark:hover:text-accent-dk font-display mt-2 inline-block text-xl transition-colors"
            href={`/blog/${post.id}`}
          >
            {post.data.title}
          </a>
          <p class="text-muted dark:text-muted-dk mt-2 max-w-prose leading-relaxed">
            {post.data.description}
          </p>
          <TagList tags={post.data.tags} class="mt-3" />
        </li>
      ))
    }
  </ul>
</Layout>
