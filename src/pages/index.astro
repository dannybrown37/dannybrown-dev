---
import { getCollection } from "astro:content";
import { existsSync, readFileSync } from "node:fs";
import PipelineDiagram from "../components/PipelineDiagram.astro";
import PostRow from "../components/PostRow.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SignalField from "../components/SignalField.astro";
import Layout from "../layouts/Layout.astro";
import { featuredProjects } from "../lib/projects";
import { svgAspect } from "../lib/svg-aspect";

// The breadth half of the T. The prose above it is the depth half, so nothing
// here repeats a tool the paragraphs already argue for — these are the edges a
// reader can't predict from "connected-vehicle backends on AWS".
const breadth: [label: string, items: string[]][] = [
  ["Languages", ["Python", "TypeScript", "JavaScript", "Bash"]],
  ["Data", ["DynamoDB", "S3", "SQLite", "PostgreSQL", "Athena", "Timestream"]],
  [
    "Infrastructure",
    [
      "AWS",
      "Terraform / OpenTofu",
      "CloudFormation",
      "Serverless Framework",
      "GCP",
    ],
  ],
  ["Python Toolchain", ["uv", "pytest", "pydantic", "ruff", "click", "mypy"]],
  [
    "Workflow",
    ["pre-commit", "GitHub Actions", "Claude Code", "Copilot", "tmux", "fzf"],
  ],
];

const featured = featuredProjects();

// Read at build time, never hardcoded: a regeneration can change the plot's
// dimensions, and a stale ratio crops it.
const gardenSvg = "public/ccgarden-plot.svg";
const garden = (existsSync(gardenSvg) &&
  svgAspect(readFileSync(gardenSvg, "utf8"))) || {
  css: "800 / 1100",
  ratio: 800 / 1100,
};

// Sized off the viewport's *height* first: the plot is taller than it is wide,
// so width-first sizing (the old `max-w-4xl`) makes something no screen can
// show at once. Full-bleed out of the prose column, capped by the height budget
// — the band minus the sticky header, heading, and caption — and by the
// viewport width so a phone gets the whole plot rather than a cropped one.
const gardenWidth = `min(56rem, 100vw - 2rem, calc((100svh - 16rem) * ${garden.ratio.toFixed(4)}))`;

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const linkClass =
  "decoration-line dark:decoration-line-dk hover:text-accent dark:hover:text-accent-dk underline underline-offset-4 transition-colors";
// One screen each. The rule that used to separate sections is gone: with a
// panel per section the whitespace does that job, and a divider line halfway up
// an otherwise empty screen just looks like a mistake.
const sectionClass = "panel";
const eyebrowClass =
  "reveal text-muted dark:text-muted-dk font-mono text-xs tracking-widest uppercase";
---

<Layout title="Home" paged>
  <section aria-labelledby="about-heading" class={sectionClass}>
    <div
      class="bg-accent dark:bg-accent-dk mb-8 h-0.5 w-10 rounded-full"
      aria-hidden="true"
    >
    </div>
    <h1
      id="about-heading"
      class="font-display max-w-prose text-4xl leading-[1.12] text-balance sm:text-5xl"
    >
      High throughput, low ceremony. I build the tooling that keeps it that way.
    </h1>
    <p class="text-muted dark:text-muted-dk mt-6 max-w-prose text-lg leading-relaxed">
      Software engineer building connected-vehicle backends on AWS, fitting LLM
      agents into engineering workflows, and making it fun to use the computer again.
    </p>
    <SignalField />
  </section>

  <!-- Prose and diagram used to share one panel, which made it the one section
       taller than the screen it was supposed to fit — so the snap lock had a
       hole in it exactly where the resume was. Nothing is cut: the resume is
       split at the seam it already had. The scale of the work reads with the
       diagram that shows it, and the taste reads with the inventory. -->
  <section aria-labelledby="experience-heading" class={sectionClass}>
    <h2 id="experience-heading" class={eyebrowClass}>Experience</h2>
    <div class="text-muted dark:text-muted-dk mt-8 space-y-4 leading-relaxed">
      <p>
        Billions of messages from thousands of vehicles, <a class={linkClass} href="https://www.linkedin.com/in/dannybrown37">across two companies since 2021</a>.
        Hundreds of fleets, a growing shelf of partner integrations,
        and firmware going over the air to hardware
        the company builds itself.
      </p>
      <p>
        DynamoDB is my store of choice when the access patterns are known upfront: single-table,
        usage driving the schema design, the Alex DeBrie school.
        Nothing I run was clicked into existence, it's all infrastructure as code.
      </p>
      <p>
        My work is often tooling that lets a project grow in scope without growing the team's
        manual checklists. CI/CD pipelines, pre-commit hooks, and
        automated tests that catch the mistakes humans and AI make. The systems I build are
        installable, self-documenting, and auditable.
      </p>
    </div>

    <PipelineDiagram view="wide" />
  </section>

  <!-- Phone only, and a panel rather than a tail on Experience above. Measured
       at 375x667 and 360x640, prose plus drawing wanted 788-801px inside a
       100svh panel: the reader lost the bottom of the IaC boundary and the
       people beyond it, which is the half of the drawing that says who the
       system is for. Shrinking the drawing can't buy that back — it is already
       at the width where `meet` scales node labels under 8px, the same thing
       that keeps the wide view off phones. So the drawing gets the screen.
       Above 40rem this section collapses to nothing and the wide drawing sits
       inside Experience as before; see .diagram / .diagram-narrow. -->
  <!-- "How I Build", not "Architecture": the drawing is a shape I reach for out
       of ordinary AWS services, and a bare noun labels it as *the* architecture
       — which invites the reader to wonder whose system they're looking at. -->
  <section aria-labelledby="approach-heading" class="diagram-panel panel">
    <h2 id="approach-heading" class={eyebrowClass}>How I Build</h2>
    <PipelineDiagram view="narrow" />
  </section>

  <section aria-labelledby="utility-belt-heading" class={sectionClass}>
    <h2 id="utility-belt-heading" class={eyebrowClass}>Utility Belt</h2>
    <div class="text-muted dark:text-muted-dk mt-8 space-y-4 leading-relaxed">
      <p>
        I keep ending up the automation guy. I notice the manual steps everyone's
        been wading through and enjoy lowering the water level.
      </p>
      <p>
        The list is living, each row roughly ordered by how much I'd want to be asked about its items.
        Things go on it when I use them enough to have an opinion,
        and off when I don't care to use them again.
      </p>
    </div>

    <!-- Deliberately quieter than the Projects pills: there a chip means "this
         repo uses this", and reusing that treatment here would both change what
         the chip claims and put thirty of them on one page. -->
    <dl
      class="border-line dark:border-line-dk text-muted dark:text-muted-dk mt-10 space-y-3 border-t pt-6 font-mono text-xs max-sm:mt-6 max-sm:space-y-2 max-sm:pt-4"
    >
      {
        breadth.map(([label, items]) => (
          <div class="sm:grid sm:grid-cols-[8rem_1fr] sm:gap-4">
            <dt class="text-accent/80 dark:text-accent-dk/80 tracking-widest uppercase">
              {label}
            </dt>
            <dd class="mt-1 leading-relaxed sm:mt-0 max-sm:leading-normal">
              {items.map((item, i) => (
                <>
                  {i > 0 && <span class="opacity-40"> · </span>}
                  <span class="hover:text-ink dark:hover:text-ink-dk transition-colors">
                    {item}
                  </span>
                </>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section aria-labelledby="projects-heading" class={sectionClass}>
    <h2 id="projects-heading" class={eyebrowClass}>Projects</h2>
    <ul class="mt-8 space-y-6 max-sm:mt-5 max-sm:space-y-4">
      {featured.map((project) => <ProjectCard project={project} compact />)}
    </ul>
    <a
      class="text-muted dark:text-muted-dk hover:text-ink dark:hover:text-ink-dk mt-8 inline-block text-sm transition-colors max-sm:mt-5"
      href="/projects"
    >
      All projects →
    </a>
  </section>

  {
    posts.length > 0 && (
      <section aria-labelledby="writing-heading" class={sectionClass}>
        <h2 id="writing-heading" class={eyebrowClass}>
          Writing
        </h2>
        <ul class="mt-8 space-y-4">
          {posts.map((post) => (
            <PostRow
              id={post.id}
              title={post.data.title}
              pubDate={post.data.pubDate}
              compact
            />
          ))}
        </ul>
        <a
          class="text-muted dark:text-muted-dk hover:text-ink dark:hover:text-ink-dk mt-8 inline-block text-sm transition-colors"
          href="/blog"
        >
          All posts →
        </a>
      </section>
    )
  }

  <section id="garden" aria-labelledby="garden-heading" class="panel">
    <h2 id="garden-heading" class={eyebrowClass}>Garden</h2>

    <!-- `data` is set by the script as the section nears the viewport, never
         here: the attribute alone starts a ~650KB fetch and parse. -->
    <div
      id="garden-frame"
      class="relative left-1/2 mt-6 -translate-x-1/2 [contain:paint]"
      style={`width: ${gardenWidth}; aspect-ratio: ${garden.css}`}
    >
      <object
        id="ccgarden"
        type="image/svg+xml"
        data-src="/ccgarden-plot.svg"
        aria-label="A top-down kitchen garden grown from my real Claude Code session history: a raised bed per repo, a plant species per model, flowers for skills."
        class="h-full w-full"
      >
      </object>
    </div>

    <p class="text-muted dark:text-muted-dk mt-6 max-w-2xl text-sm">
      <a
        class={linkClass}
        href="https://github.com/dannybrown37/ccgarden"><code class="font-mono">ccgarden</code></a> is
        generative art built from Claude Code
        session history. Drag the scrubber to watch this plot fill
        in; hover or tap anything for the numbers behind it.
    </p>
  </section>

  <script>
    function controlGarden() {
      const object = document.getElementById("ccgarden");
      if (!(object instanceof HTMLObjectElement)) return;

      let onScreen = false;
      // The palette opens on top of the plot, so intersection alone still
      // leaves it repainting while someone is typing into it.
      let paletteOpen = false;

      // The idle motion is CSS keyframes inside the <object>'s own document,
      // so it needs a switch of its own. Namespaced: the SVG is a real XML
      // document, and a null-namespace <style> would parse but never apply.
      let halt: Element | null = null;
      const sync = () => {
        const svg = object.contentDocument?.documentElement;
        if (!svg) return;
        halt ??= svg.ownerDocument.createElementNS("http://www.w3.org/2000/svg", "style");
        halt.textContent = "*{animation-play-state:paused !important}";
        if (onScreen && !paletteOpen) halt.remove();
        else svg.append(halt);
      };
      object.addEventListener("load", sync);

      const observer = new IntersectionObserver(
        ([entry]) => {
          onScreen = entry.isIntersecting;
          if (onScreen && !object.data) object.data = object.dataset.src ?? "";
          sync();
        },
        { rootMargin: "100% 0px" },
      );
      observer.observe(object);

      const onPalette = (event: Event) => {
        paletteOpen = (event as CustomEvent<{ open: boolean }>).detail.open;
        sync();
      };
      document.addEventListener("palette:toggle", onPalette);

      document.addEventListener(
        "astro:before-swap",
        () => {
          observer.disconnect();
          document.removeEventListener("palette:toggle", onPalette);
        },
        { once: true },
      );
    }

    // Same rule the garden follows, for the same reason: the hero field and the
    // pipeline diagram loop forever, and a paged layout means each one spends
    // most of the visit scrolled off screen still repainting. CSS owns the
    // pause; this only marks who is visible.
    function controlFlow() {
      const flows = document.querySelectorAll<HTMLElement>("[data-flow]");
      if (!flows.length) return;

      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          const element = entry.target as HTMLElement;
          if (entry.isIntersecting) delete element.dataset.flowPaused;
          else element.dataset.flowPaused = "";
        }
      });

      for (const flow of flows) observer.observe(flow);
      document.addEventListener("astro:before-swap", () => observer.disconnect(), {
        once: true,
      });
    }

    document.addEventListener("astro:page-load", controlGarden);
    document.addEventListener("astro:page-load", controlFlow);
  </script>
</Layout>
