---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PostRow from "../components/PostRow.astro";

interface Project {
  name: string;
  description: string;
  url: string;
  tech: string[];
  /** Links to a running site rather than to source. */
  live?: boolean;
  /** Only for projects installable from a public index — not `git+https://…` fallbacks. */
  install?: string;
  /** SPDX id of the repo's LICENSE file. Omit when the repo has none. */
  license?: string;
}

// These are the repos the ccgarden tree above is grown from.
const projects: Project[] = [
  {
    name: "gtd",
    description:
      "A TUI, CLI, and API for personal productivity built around Getting Things Done. Capture to an inbox, triage into projects with contexts and next actions, auto-reschedule recurring items, and run reviews grouped by Area of Focus.",
    url: "https://github.com/dannybrown37/gtd",
    tech: ["Python", "TUI", "Flask"],
    install: "uv tool install gtd-tui",
    license: "MIT",
  },
  {
    name: "hamilhamilhamil",
    description:
      "CamelCamelCamel for Broadway: a daily scrape of the TKTS discount board into a price/discount history per show. Python scraper on a GitHub Actions cron, Next.js frontend on Vercel, Postgres in between.",
    url: "https://hamilhamilhamil.com",
    tech: ["Next.js", "TypeScript", "Python", "Postgres"],
    live: true,
  },
  {
    name: "skill-tree",
    description:
      "A shared home for reusable Claude Code skills: the tooling behind each skill, not just its playbook. Portable across repos and machines, packaged as a single installable plugin that is also its own marketplace.",
    url: "https://github.com/dannybrown37/skill-tree",
    tech: ["Claude Code", "Python", "Bash"],
    install: `/plugin marketplace add dannybrown37/skill-tree\n/plugin install skill-tree@skill-tree`,
    license: "MIT",
  },
  {
    name: "git-a-grip",
    description: "Control your git history with this curated collection of neato pre-commit hooks.",
    url: "https://github.com/dannybrown37/git-a-grip",
    tech: ["Pre-Commit", "Python", "Commitizen"]
  },
  {
    name: "dotfiles",
    description: "Shell config and global dev tooling. And the sandbox where most of my projects start.",
    url: "https://github.com/dannybrown37/dotfiles",
    tech: ["Bash", "Python", "TMUX", "Neovim", "WSL", "AutoHotKey", "Pre-Commit"],
  },
  {
    name: "ccgarden",
    description:
      "Grows a tree from your Claude Code session history: each item represents a statistic. Check it out above!",
    url: "https://github.com/dannybrown37/ccgarden",
    tech: ["Python", "SVG", "SMIL", "SQLite", "Claude Code"],
    install: "uv tool install ccgarden",
    license: "MIT",
  },
  {
    name: "dannybrown.dev",
    description: "This site.",
    url: "https://www.dannybrown.dev",
    tech: ["Astro", "Tailwind", "TypeScript"],
    live: true,
  },
];

const stack = [
  "AWS Lambda",
  "DynamoDB",
  "API Gateway",
  "IoT Core",
  "Node.js",
  "TypeScript",
  "Python",
  "IaC",
];

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const linkClass =
  "decoration-line dark:decoration-line-dk hover:text-accent dark:hover:text-accent-dk underline underline-offset-4 transition-colors";
const sectionClass = "border-line dark:border-line-dk mt-24 border-t pt-12";
const eyebrowClass =
  "reveal text-muted dark:text-muted-dk font-mono text-xs tracking-widest uppercase";
---

<Layout title="Home">
  <section aria-labelledby="about-heading">
    <div
      class="bg-accent dark:bg-accent-dk mb-8 h-0.5 w-10 rounded-full"
      aria-hidden="true"
    >
    </div>
    <h1
      id="about-heading"
      class="font-display max-w-prose text-4xl leading-[1.12] text-balance sm:text-5xl"
    >
      High throughput, low ceremony. I build the tooling that keeps it that way.
    </h1>
    <p class="text-muted dark:text-muted-dk mt-6 max-w-prose text-lg leading-relaxed">
      Level 4 / Staff-equivalent software engineer fitting LLM agents into real engineering
      workflows, accomplishing tasks with the fewest motions possible, and making
      it fun to use the computer again.
    </p>
  </section>

  <!-- <object>, not <img>: the SVG needs its own document so its tooltips,
       SMIL growth animation, and time-travel scrubber script all work. -->
  <!-- contain:paint keeps the tree's continuous repaints inside this box; without
       it the whole page re-composites on every scroll frame while it's visible. -->
  <div
    class="relative left-1/2 mt-12 aspect-[800/848] w-screen max-w-4xl -translate-x-1/2 px-4 [contain:paint]"
  >
    <object
      id="ccgarden"
      type="image/svg+xml"
      data="/ccgarden.svg"
      class="h-full w-full"
      aria-label="A ccgarden tree visualization grown from my real Claude Code session history, regenerated on each commit"
    >
      <p class="text-muted dark:text-muted-dk max-w-prose text-sm">
        A tree grown from my Claude Code session history — it needs SVG support to
        render. <a class={linkClass} href="https://github.com/dannybrown37/ccgarden"
          >ccgarden</a
        > builds it.
      </p>
    </object>
  </div>

  <p class="text-muted dark:text-muted-dk mt-8 max-w-2xl text-sm">
    <code class="font-mono">ccgarden</code> is generative art built from Claude Code
    session history, regrown on every commit — hover or tap anything for the numbers
    behind it, or <a class={linkClass} href="https://github.com/dannybrown37/ccgarden"
      >grow your own</a
    >. Dollar figures are notional, priced at listed API rates.
  </p>

  <section aria-labelledby="experience-heading" class={sectionClass}>
    <h2 id="experience-heading" class={eyebrowClass}>Experience</h2>
    <div class="text-muted dark:text-muted-dk mt-8 max-w-prose space-y-4 leading-relaxed">
      <p>
        I've been building backends for connected vehicles since 2021, handling billions of
        messages from thousands of vehicles, across two companies in the space.
      </p>
      <p>
        The firehose of data arrives via MQTT topics on AWS IoT Core,
        hydrating downstream services using Lambda, API Gateway, S3, and the rest
        of the AWS Serverless toolkit.
      </p>
      <p>
        DynamoDB is my deep end; I've waded into Postgres, SQL Server, Timestream,
        and more. I'm from the Alex DeBrie school: single-table when
        accessing items together and query shapes driving the schema design rather than
        the other way around.
      </p>
      <p>
        Infrastructure as Code always, across CloudFormation, Terraform, OpenTofu, and
        Serverless Framework. Firmly a backend engineer, shifted left.
      </p>
    </div>
    <ul class="text-muted dark:text-muted-dk mt-6 flex flex-wrap gap-2 font-mono text-xs">
      {
        stack.map((tech) => (
          <li class="bg-paper-soft dark:bg-paper-soft-dk rounded-full px-2.5 py-1">
            {tech}
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="projects-heading" class={sectionClass}>
    <h2 id="projects-heading" class={eyebrowClass}>Projects</h2>
    <ul class="mt-8 space-y-6">
      {
        projects.map((project) => (
          <li class="group border-line dark:border-line-dk hover:border-accent dark:hover:border-accent-dk hover:bg-accent/5 dark:hover:bg-accent-dk/10 relative rounded-r-md border-l py-3 pr-4 pl-5 transition-[background-color,border-color,transform] motion-safe:hover:translate-x-1">
            <a
              class="group-hover:text-accent dark:group-hover:text-accent-dk font-display inline-flex items-baseline gap-2 text-lg transition-colors after:absolute after:inset-0"
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {project.name}
              <span
                aria-hidden="true"
                class="text-muted dark:text-muted-dk transition-transform group-hover:translate-x-0.5"
              >
                ↗
              </span>
            </a>
            {project.live && (
              <span class="text-accent dark:text-accent-dk ml-2 inline-flex items-center gap-1.5 align-middle font-mono text-xs">
                <span
                  class="bg-accent dark:bg-accent-dk h-1.5 w-1.5 rounded-full"
                  aria-hidden="true"
                />
                live
              </span>
            )}
            {project.license && (
              /* Muted, not accent: `live` stays the one loud badge in the row.
                 U+FE0E forces text presentation — bare U+2696 renders as a color
                 emoji on Android and Windows, which breaks the mono badge line. */
              <span
                class="text-muted dark:text-muted-dk ml-2 inline-flex items-center gap-1.5 align-middle font-mono text-xs"
                title={`Released under the ${project.license} license`}
              >
                <span aria-hidden="true">{"⚖︎"}</span>
                {project.license}
              </span>
            )}
            <p class="text-muted dark:text-muted-dk mt-2 max-w-prose leading-relaxed">
              {project.description}
            </p>
            {project.install && (
              /* relative: lifts the snippet above the card-wide ::after overlay on the
                 title link, so it can actually be selected and copied. */
              <pre class="border-accent/40 dark:border-accent-dk/40 text-muted dark:text-muted-dk relative mt-3 max-w-prose overflow-x-auto border-l-2 py-0.5 pl-3 font-mono text-xs leading-relaxed"><code>{project.install}</code></pre>
            )}
            <ul class="text-muted dark:text-muted-dk mt-3 flex flex-wrap gap-2 font-mono text-xs">
              {project.tech.map((tech) => (
                <li class="bg-paper-soft dark:bg-paper-soft-dk rounded-full px-2.5 py-1">
                  {tech}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  {
    posts.length > 0 && (
      <section aria-labelledby="writing-heading" class={sectionClass}>
        <h2 id="writing-heading" class={eyebrowClass}>
          Writing
        </h2>
        <ul class="mt-8 space-y-4">
          {posts.map((post) => (
            <PostRow
              id={post.id}
              title={post.data.title}
              pubDate={post.data.pubDate}
              compact
            />
          ))}
        </ul>
        <a
          class="text-muted dark:text-muted-dk hover:text-ink dark:hover:text-ink-dk mt-8 inline-block text-sm transition-colors"
          href="/blog"
        >
          All posts →
        </a>
      </section>
    )
  }

  <!-- Six of the tree's animations are repeatCount="indefinite", so it never
       settles on its own — left alone it repaints for as long as the page is
       open, including while it's scrolled out of view. SMIL exposes its own
       timeline controls, so pause it whenever it isn't actually on screen. -->
  <script>
    function controlGarden() {
      const object = document.getElementById("ccgarden");
      if (!(object instanceof HTMLObjectElement)) return;

      const attach = () => {
        const svg = object.contentDocument?.documentElement;
        if (!(svg instanceof SVGSVGElement)) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          svg.pauseAnimations();
          return;
        }

        const observer = new IntersectionObserver(
          ([entry]) => {
            if (entry.isIntersecting) svg.unpauseAnimations();
            else svg.pauseAnimations();
          },
          { rootMargin: "100px" },
        );
        observer.observe(object);

        document.addEventListener("astro:before-swap", () => observer.disconnect(), {
          once: true,
        });
      };

      // contentDocument is null until the SVG's own document finishes parsing,
      // and a bfcache restore replays neither event — so try both paths.
      if (object.contentDocument?.readyState === "complete") attach();
      object.addEventListener("load", attach);
    }

    document.addEventListener("astro:page-load", controlGarden);
  </script>
</Layout>
