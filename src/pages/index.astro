---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home">
  <h1 class="text-3xl font-bold">Danny Brown</h1>
  <p class="mt-4 text-lg">
    Senior Software Engineer with an unyielding growth mindset.
  </p>

  <section class="mt-10">
    <h2 class="text-xl font-semibold">Latest Progress</h2>\
    <!-- <object>, not <img>: the SVG needs its own document so its tooltips,
         SMIL growth animation, and time-travel scrubber script all work. -->
    <div
      class="relative left-1/2 mt-4 aspect-[800/848] w-screen max-w-3xl -translate-x-1/2 px-4"
    >
      <object
        type="image/svg+xml"
        data="/ccgarden.svg"
        class="h-full w-full"
        aria-label="A ccgarden tree visualization grown from my real Claude Code session history, regenerated on each commit"
      >
      </object>
    </div>
    <p class="mt-2 text-gray-600 dark:text-gray-400">
      <code>ccgarden</code> is a generative-art tree grown from Claude Code session
      history. See the legend or hover/tap to see the stats.
      {" "}<a class="underline" href="https://github.com/dannybrown37/ccgarden">
        You can try it yourself!
      </a>
    </p>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
      The dollar figures are based on listed API prices and just for "value" tracking.
      I'm using a $20 Claude Pro subscription.
    </p>
    <p class="mt-2 text-sm">

    </p>
  </section>
</Layout>
