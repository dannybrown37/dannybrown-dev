---
import { readFileSync } from "node:fs";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PostRow from "../components/PostRow.astro";
import SignalField from "../components/SignalField.astro";
import PipelineDiagram from "../components/PipelineDiagram.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { featuredProjects } from "../lib/projects";
import { svgAspect } from "../lib/svg-aspect";

// The breadth half of the T. The prose above it is the depth half, so nothing
// here repeats a tool the paragraphs already argue for — these are the edges a
// reader can't predict from "connected-vehicle backends on AWS".
const breadth: [label: string, items: string[]][] = [
  ["Languages", ["Python", "TypeScript", "JavaScript", "Node.js", "Bash"]],
  [
    "Infrastructure",
    ["AWS", "Terraform", "OpenTofu", "CloudFormation", "Serverless Framework", "GitHub Actions", "Jenkins"],
  ],
  ["Data", ["DynamoDB", "Postgres", "Athena", "Timestream", "SQLite"]],
];

const featured = featuredProjects();

// Read at build time, never hardcoded: the tree grows a little taller with
// every regeneration, and a stale ratio crops the canopy.
const garden = svgAspect(readFileSync("public/ccgarden.svg", "utf8")) ?? {
  css: "800 / 966",
  ratio: 800 / 966,
};

// Sized off the viewport's *height* first: the tree is taller than it is wide,
// so width-first sizing (the old `max-w-4xl`) makes something no screen can
// show at once. Full-bleed out of the prose column, capped by the height budget
// — the band minus the sticky header, heading, and caption — and by the
// viewport width so a phone gets the whole tree rather than a cropped one.
const gardenWidth = `min(56rem, 100vw - 2rem, calc((100svh - 15rem) * ${garden.ratio.toFixed(4)}))`;

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const linkClass =
  "decoration-line dark:decoration-line-dk hover:text-accent dark:hover:text-accent-dk underline underline-offset-4 transition-colors";
// One screen each. The rule that used to separate sections is gone: with a
// panel per section the whitespace does that job, and a divider line halfway up
// an otherwise empty screen just looks like a mistake.
const sectionClass = "panel";
const eyebrowClass =
  "reveal text-muted dark:text-muted-dk font-mono text-xs tracking-widest uppercase";
---

<Layout title="Home" paged>
  <section aria-labelledby="about-heading" class={sectionClass}>
    <div
      class="bg-accent dark:bg-accent-dk mb-8 h-0.5 w-10 rounded-full"
      aria-hidden="true"
    >
    </div>
    <h1
      id="about-heading"
      class="font-display max-w-prose text-4xl leading-[1.12] text-balance sm:text-5xl"
    >
      High throughput, low ceremony. I build the tooling that keeps it that way.
    </h1>
    <p class="text-muted dark:text-muted-dk mt-6 max-w-prose text-lg leading-relaxed">
      Senior software engineer building connected-vehicle backends on AWS, fitting LLM
      agents into engineering workflows, and making it fun to use the computer again.
    </p>
    <SignalField />
  </section>

  <section aria-labelledby="experience-heading" class={sectionClass}>
    <h2 id="experience-heading" class={eyebrowClass}>Experience</h2>
    <div class="text-muted dark:text-muted-dk mt-8 max-w-prose space-y-4 leading-relaxed">
      <p>
        Billions of messages handled from thousands of vehicles, across two companies since 2021.
      </p>
      <p>
        Infrastructure as Code always: nothing I run was clicked into existence.
      </p>
      <p>
        DynamoDB is my store of choice, provided I know my access patterns upfront.
        I'm from the Alex DeBrie school: letting usage define the schema definitions
        and storing simultaneously retrieved items in the same table.
      </p>
      <p>
        I end up the Automation Guy in every role. I notice the manual steps everyone's
        been wading through, and I truly enjoy lowering the water level.
      </p>
    </div>

    <PipelineDiagram />

    <!-- Deliberately quieter than the Projects pills: there a chip means "this
         repo uses this", and reusing that treatment here would both change what
         the chip claims and put thirty of them on one page. -->
    <dl
      class="border-line dark:border-line-dk text-muted dark:text-muted-dk mt-10 max-w-prose space-y-3 border-t pt-6 font-mono text-xs"
    >
      {
        breadth.map(([label, items]) => (
          <div class="sm:grid sm:grid-cols-[8rem_1fr] sm:gap-4">
            <dt class="tracking-widest uppercase opacity-70">{label}</dt>
            <dd class="mt-1 leading-relaxed sm:mt-0">{items.join(" · ")}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- A full-viewport band, and the only snapping target on the site.
       `scroll-snap-stop: always` is the lock: a fling that would carry past the
       garden has to stop here first, so you land on it square instead of
       catching a sliver of it on the way to Projects. Only this one section
       gets that treatment — page-wide mandatory snapping breaks keyboard
       paging and find-in-page on the prose above and below. -->
  <section
    id="garden"
    aria-labelledby="garden-heading"
    class="panel [scroll-snap-stop:always]"
  >
    <h2 id="garden-heading" class={eyebrowClass}>Garden</h2>

    <!-- <object>, not <img>: the SVG needs its own document so its tooltips,
         SMIL growth animation, and time-travel scrubber script all work.
         `data` is set by the script below instead of here — it's a 3MB document
         with thousands of animation elements, and parsing it during initial
         load is what made the rest of the page (the command palette especially)
         feel sticky before you had even scrolled to the tree. -->
    <!-- contain:paint keeps the tree's continuous repaints inside this box; without
         it the whole page re-composites on every scroll frame while it's visible. -->
    <div
      class="relative left-1/2 mt-6 -translate-x-1/2 [contain:paint]"
      style={`width: ${gardenWidth}; aspect-ratio: ${garden.css}`}
    >
      <!-- Starts transparent in the markup, not from the script: the SVG paints
           the moment its document parses, which is before `load` fires, so a
           script-applied fade leaves a flash of night sky every time. -->
      <object
        id="ccgarden"
        type="image/svg+xml"
        data-src="/ccgarden.svg"
        class="h-full w-full opacity-0 transition-opacity duration-700"
        aria-label="A ccgarden tree visualization grown from my real Claude Code session history, regenerated on each commit"
      >
        <p class="text-muted dark:text-muted-dk max-w-prose text-sm">
          A tree grown from my Claude Code session history — it needs SVG support to
          render. <a class={linkClass} href="https://github.com/dannybrown37/ccgarden"
            >ccgarden</a
          > builds it.
        </p>
      </object>
      <!-- The id outranks the utility class, so the fallback above is visible
           to anyone whose browser will never run the script that reveals it. -->
      <noscript><style>#ccgarden { opacity: 1 }</style></noscript>
    </div>

    <p class="text-muted dark:text-muted-dk mt-6 max-w-2xl text-sm">
      <code class="font-mono">ccgarden</code> is generative art built from Claude Code
      session history, regrown on every commit — hover or tap anything for the numbers
      behind it, or <a class={linkClass} href="https://github.com/dannybrown37/ccgarden"
        >grow your own</a
      >. Dollar figures are notional, priced at listed API rates.
    </p>
  </section>

  <section aria-labelledby="projects-heading" class={sectionClass}>
    <h2 id="projects-heading" class={eyebrowClass}>Projects</h2>
    <ul class="mt-8 space-y-6">
      {featured.map((project) => <ProjectCard project={project} compact />)}
    </ul>
    <a
      class="text-muted dark:text-muted-dk hover:text-ink dark:hover:text-ink-dk mt-8 inline-block text-sm transition-colors"
      href="/projects"
    >
      All projects →
    </a>
  </section>

  {
    posts.length > 0 && (
      <section aria-labelledby="writing-heading" class={sectionClass}>
        <h2 id="writing-heading" class={eyebrowClass}>
          Writing
        </h2>
        <ul class="mt-8 space-y-4">
          {posts.map((post) => (
            <PostRow
              id={post.id}
              title={post.data.title}
              pubDate={post.data.pubDate}
              compact
            />
          ))}
        </ul>
        <a
          class="text-muted dark:text-muted-dk hover:text-ink dark:hover:text-ink-dk mt-8 inline-block text-sm transition-colors"
          href="/blog"
        >
          All posts →
        </a>
      </section>
    )
  }

  <!-- The tree's idle motion — wind, twinkle, rain — is CSS keyframe animation
       set to `infinite`, so it never settles on its own: left alone it repaints
       for as long as the page is open, including while scrolled out of view.
       SMIL exposes its own timeline controls, so pause it whenever it isn't
       actually on screen, and don't even fetch it until it's close. -->
  <script>
    const GROWN = 60; // seconds; comfortably past the longest growth animation.

    function controlGarden() {
      const object = document.getElementById("ccgarden");
      if (!(object instanceof HTMLObjectElement)) return;

      const attach = () => {
        // Duck-typed, and it has to be. `instanceof SVGSVGElement` is false
        // here: <object> is its own browsing context with its own realm, so
        // the root element is an instance of the *inner* window's constructor,
        // never this one's. That guard silently disabled everything below it.
        const svg = object.contentDocument?.documentElement as SVGSVGElement | undefined;
        if (typeof svg?.pauseAnimations !== "function") return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          // Jump to the end before pausing. Pausing at t=0 freezes the growth
          // animations before anything has grown — a blank patch of dirt.
          svg.setCurrentTime(GROWN);
          svg.pauseAnimations();
          return;
        }

        let onScreen = false;
        // The palette opens on top of the tree, so intersection alone still
        // leaves it repainting while someone is typing into it — and the
        // keystrokes lose the main thread to it.
        let paletteOpen = false;

        // pauseAnimations() only reaches SMIL. The idle motion — wind, the
        // star twinkle, the rain — is CSS keyframes, which needs its own
        // switch or it keeps running through both pauses below.
        // Namespaced: the SVG is a real XML document, and a null-namespace
        // <style> from createElement would parse but never apply.
        const halt = svg.ownerDocument.createElementNS(
          "http://www.w3.org/2000/svg",
          "style",
        );
        halt.textContent = "*{animation-play-state:paused !important}";

        // Held at t=0 until it's actually in front of someone: the growth is an
        // 18-second one-shot, and starting it on load meant it was always over
        // by the time you scrolled down to it. Hidden as well as paused —
        // frame zero is an empty night sky, which just reads as a big blank
        // box sitting there rather than as something about to happen.
        let growing = false;
        svg.pauseAnimations();
        svg.append(halt);

        const sync = () => {
          if (onScreen && !paletteOpen) {
            if (!growing) {
              growing = true;
              svg.setCurrentTime(0);
              object.style.opacity = "1";
            }
            svg.unpauseAnimations();
            halt.remove();
          } else {
            svg.pauseAnimations();
            svg.append(halt);
            // Only when a replay is armed — a palette pause happens right on
            // top of the tree, and blanking it there would be jarring.
            if (!growing) object.style.opacity = "0";
          }
        };

        const observer = new IntersectionObserver(
          ([entry]) => {
            // Not intersectionRatio: the tree is often taller than the viewport,
            // where the ratio tops out well below 1 and a plain threshold would
            // never fire. Measure against how much of it *can* be shown.
            const showable = Math.min(
              entry.boundingClientRect.height,
              entry.rootBounds?.height ?? window.innerHeight,
            );
            const covered = showable > 0 ? entry.intersectionRect.height / showable : 0;
            // Asymmetric on purpose: it takes a near-full reveal to start, but
            // only leaving the viewport entirely to stop — otherwise it freezes
            // mid-sway the moment you scroll down to read the caption.
            onScreen = onScreen ? entry.isIntersecting : covered >= 0.9;
            // Leaving entirely arms a replay: scrolling back to the garden is a
            // deliberate trip, and the growth is the reason to make it.
            if (!entry.isIntersecting) growing = false;
            sync();
          },
          { threshold: Array.from({ length: 21 }, (_, step) => step / 20) },
        );
        observer.observe(object);

        const onPalette = (event: Event) => {
          paletteOpen = (event as CustomEvent<{ open: boolean }>).detail.open;
          sync();
        };
        document.addEventListener("palette:toggle", onPalette);

        document.addEventListener(
          "astro:before-swap",
          () => {
            observer.disconnect();
            document.removeEventListener("palette:toggle", onPalette);
          },
          { once: true },
        );
      };

      // contentDocument is null until the SVG's own document finishes parsing,
      // and a bfcache restore replays neither event — so try both paths.
      if (object.contentDocument?.readyState === "complete") attach();
      object.addEventListener("load", attach);

      // Fetch and parse only once it's genuinely being approached. Loading it
      // up front costs 3MB and several thousand animation elements' worth of
      // main thread during the page's first seconds, which everything else —
      // the command palette most visibly — has to queue behind. A margin of a
      // whole viewport meant "immediately" on a tall screen, since the band
      // begins just below the fold.
      const src = object.dataset.src;
      if (!src) return;

      const loader = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          loader.disconnect();
          // Idle, because on a tall screen the band's top edge is already in
          // view at scroll 0 — the observer fires during load, and parsing
          // 3MB right then is the thing that made the palette feel sticky.
          // It stays invisible and paused until the reveal either way.
          const parse = () => (object.data = src);
          "requestIdleCallback" in window
            ? requestIdleCallback(parse, { timeout: 2000 })
            : setTimeout(parse, 200);
        },
        { rootMargin: "25% 0px" },
      );
      loader.observe(object);
      document.addEventListener("astro:before-swap", () => loader.disconnect(), {
        once: true,
      });
    }

    // Same rule the garden follows, for the same reason: the hero field and the
    // pipeline diagram loop forever, and a paged layout means each one spends
    // most of the visit scrolled off screen still repainting. CSS owns the
    // pause; this only marks who is visible.
    function controlFlow() {
      const flows = document.querySelectorAll<HTMLElement>("[data-flow]");
      if (!flows.length) return;

      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          const element = entry.target as HTMLElement;
          if (entry.isIntersecting) delete element.dataset.flowPaused;
          else element.dataset.flowPaused = "";
        }
      });

      for (const flow of flows) observer.observe(flow);
      document.addEventListener("astro:before-swap", () => observer.disconnect(), {
        once: true,
      });
    }

    document.addEventListener("astro:page-load", controlGarden);
    document.addEventListener("astro:page-load", controlFlow);
  </script>
</Layout>
