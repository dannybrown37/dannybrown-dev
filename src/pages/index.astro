---
import { readFileSync } from "node:fs";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PostRow from "../components/PostRow.astro";
import SignalField from "../components/SignalField.astro";
import PipelineDiagram from "../components/PipelineDiagram.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { featuredProjects } from "../lib/projects";
import { svgAspect } from "../lib/svg-aspect";

// The breadth half of the T. The prose above it is the depth half, so nothing
// here repeats a tool the paragraphs already argue for — these are the edges a
// reader can't predict from "connected-vehicle backends on AWS".
const breadth: [label: string, items: string[]][] = [
  ["Languages", ["Python", "TypeScript", "JavaScript", "Bash", "Lua"]],
  ["Infrastructure", ["AWS", "Terraform", "OpenTofu", "CloudFormation", "Serverless Framework"]],
  ["Data", ["DynamoDB", "Postgres", "SQLite", "Athena", "Timestream", "SQL Server", "Firestore"]],
  ["Daily Drivers", ["tmux", "uv", "pre-commit", "pytest", "ruff", "fzf", "GitHub Actions"]]

];

const featured = featuredProjects();

// Read at build time, never hardcoded: the tree grows a little taller with
// every regeneration, and a stale ratio crops the canopy.
const garden = svgAspect(readFileSync("public/ccgarden.svg", "utf8")) ?? {
  css: "800 / 966",
  ratio: 800 / 966,
};

// Sized off the viewport's *height* first: the tree is taller than it is wide,
// so width-first sizing (the old `max-w-4xl`) makes something no screen can
// show at once. Full-bleed out of the prose column, capped by the height budget
// — the band minus the sticky header, heading, and caption — and by the
// viewport width so a phone gets the whole tree rather than a cropped one.
const gardenWidth = `min(56rem, 100vw - 2rem, calc((100svh - 16rem) * ${garden.ratio.toFixed(4)}))`;

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const linkClass =
  "decoration-line dark:decoration-line-dk hover:text-accent dark:hover:text-accent-dk underline underline-offset-4 transition-colors";
// One screen each. The rule that used to separate sections is gone: with a
// panel per section the whitespace does that job, and a divider line halfway up
// an otherwise empty screen just looks like a mistake.
const sectionClass = "panel";
const eyebrowClass =
  "reveal text-muted dark:text-muted-dk font-mono text-xs tracking-widest uppercase";
---

<Layout title="Home" paged>
  <section aria-labelledby="about-heading" class={sectionClass}>
    <div
      class="bg-accent dark:bg-accent-dk mb-8 h-0.5 w-10 rounded-full"
      aria-hidden="true"
    >
    </div>
    <h1
      id="about-heading"
      class="font-display max-w-prose text-4xl leading-[1.12] text-balance sm:text-5xl"
    >
      High throughput, low ceremony. I build the tooling that keeps it that way.
    </h1>
    <p class="text-muted dark:text-muted-dk mt-6 max-w-prose text-lg leading-relaxed">
      Senior software engineer building connected-vehicle backends on AWS, fitting LLM
      agents into engineering workflows, and making it fun to use the computer again.
    </p>
    <SignalField />
  </section>

  <!-- Prose and diagram used to share one panel, which made it the one section
       taller than the screen it was supposed to fit — so the snap lock had a
       hole in it exactly where the resume was. Nothing is cut: the resume is
       split at the seam it already had. The scale of the work reads with the
       diagram that shows it, and the taste reads with the inventory. -->
  <section aria-labelledby="experience-heading" class={sectionClass}>
    <h2 id="experience-heading" class={eyebrowClass}>Experience</h2>
    <div class="text-muted dark:text-muted-dk mt-8 space-y-4 leading-relaxed">
      <p>
        Billions of messages from thousands of vehicles, across two companies since 2021. See
        more details on <a class={linkClass} href="https://www.linkedin.com/in/dannybrown37">LinkedIn</a>.
      </p>
      <p>
        Every end user drives the downnstream web application differently, which means the
        product needs flexibility alongside reliability.
      </p>
      <p>
        Infrastructure as Code? Nothing I run was clicked into existence. If it's not repeatable, it's not done.
      </p>
    </div>

    <PipelineDiagram />
  </section>

  <section aria-labelledby="toolbelt-heading" class={sectionClass}>
    <h2 id="toolbelt-heading" class={eyebrowClass}>Toolbelt</h2>
    <div class="text-muted dark:text-muted-dk mt-8 space-y-4 leading-relaxed">
      <p>
        DynamoDB is my store of choice when I know the access patterns upfront: single-table,
        usage driving the schema design, the Alex DeBrie school.
      </p>
      <p>
        I end up the Automation Guy on every team I join. I can't help but notice the manual steps everyone's
        been wading through, and I find joy in lowering the water level.
      </p>
      <p>
        More than that, I build installable, self-documenting, auditable <em>systems</em>. "It works on my machine"
        is just not an acceptable phrase in my world. If I step away from a project, I must be able to step
        back in months or years later without breaking stride.
      </p>
    </div>

    <!-- Deliberately quieter than the Projects pills: there a chip means "this
         repo uses this", and reusing that treatment here would both change what
         the chip claims and put thirty of them on one page. -->
    <dl
      class="border-line dark:border-line-dk text-muted dark:text-muted-dk mt-10 space-y-3 border-t pt-6 font-mono text-xs"
    >
      {
        breadth.map(([label, items]) => (
          <div class="sm:grid sm:grid-cols-[8rem_1fr] sm:gap-4">
            <dt class="tracking-widest uppercase opacity-70">{label}</dt>
            <dd class="mt-1 leading-relaxed sm:mt-0">{items.join(" · ")}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- A full-viewport band, and the only snapping target on the site.
       `scroll-snap-stop: always` is the lock: a fling that would carry past the
       garden has to stop here first, so you land on it square instead of
       catching a sliver of it on the way to Projects. Only this one section
       gets that treatment — page-wide mandatory snapping breaks keyboard
       paging and find-in-page on the prose above and below. -->
  <section
    id="garden"
    aria-labelledby="garden-heading"
    class="panel [scroll-snap-stop:always]"
  >
    <h2 id="garden-heading" class={eyebrowClass}>Garden</h2>

    <!-- The default render is a *still* — see src/lib/ccgarden-poster.ts. The
         live document is 3MB of SMIL across five thousand animation elements
         plus two scripts of its own, and paying for that on every visit is
         what made the whole page feel like wading: the palette went sticky,
         scrolling dropped frames, and the snap never settled. An <img> of the
         frozen end state costs one rasterization and no main thread at all.

         contain:paint keeps the live version's repaints inside this box once
         it is running; without it the whole page re-composites every frame. -->
    <div
      id="garden-frame"
      class="relative left-1/2 mt-6 -translate-x-1/2 [contain:paint]"
      style={`width: ${gardenWidth}; aspect-ratio: ${garden.css}`}
    >
      <img
        id="ccgarden-poster"
        src="/ccgarden-poster.svg"
        width="800"
        height="966"
        decoding="async"
        class="h-full w-full transition-opacity duration-500"
        alt="A tree grown from my real Claude Code session history: trunk width from total sessions, one branch per repo, leaves for each session, under a sky that darkens with late-night prompts."
      />

      <!-- Empty until asked for. `data` is set by the script, never here: the
           attribute alone starts the 3MB fetch and parse. -->
      <object
        id="ccgarden"
        type="image/svg+xml"
        data-src="/ccgarden.svg"
        aria-label="The same garden, growing from bare ground to today"
        class="pointer-events-none absolute inset-0 h-full w-full opacity-0 transition-opacity duration-500"
      >
      </object>

      <!-- Gated on data-ready so a no-JS visitor is left with the poster
           rather than a button that does nothing. -->
      <button
        id="garden-play"
        type="button"
        class="bg-paper/85 dark:bg-paper-dk/85 border-line dark:border-line-dk text-ink dark:text-ink-dk hover:border-accent dark:hover:border-accent-dk absolute top-3 left-3 hidden items-center gap-2 rounded-full border px-3.5 py-2 font-mono text-xs backdrop-blur transition-colors data-ready:inline-flex"
      >
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z"></path>
        </svg>
        <span id="garden-play-label">Watch it grow</span>
      </button>
    </div>

    <p class="text-muted dark:text-muted-dk mt-6 max-w-2xl text-sm">
      <code class="font-mono">ccgarden</code> is generative art built from Claude Code
      session history, regrown on every commit. Play it to watch this tree grow from
      bare ground and to hover or tap anything for the numbers behind it — or <a
        class={linkClass}
        href="https://github.com/dannybrown37/ccgarden">grow your own</a
      >. Dollar figures are notional, priced at listed API rates.
    </p>
  </section>

  <section aria-labelledby="projects-heading" class={sectionClass}>
    <h2 id="projects-heading" class={eyebrowClass}>Projects</h2>
    <ul class="mt-8 space-y-6">
      {featured.map((project) => <ProjectCard project={project} compact />)}
    </ul>
    <a
      class="text-muted dark:text-muted-dk hover:text-ink dark:hover:text-ink-dk mt-8 inline-block text-sm transition-colors"
      href="/projects"
    >
      All projects →
    </a>
  </section>

  {
    posts.length > 0 && (
      <section aria-labelledby="writing-heading" class={sectionClass}>
        <h2 id="writing-heading" class={eyebrowClass}>
          Writing
        </h2>
        <ul class="mt-8 space-y-4">
          {posts.map((post) => (
            <PostRow
              id={post.id}
              title={post.data.title}
              pubDate={post.data.pubDate}
              compact
            />
          ))}
        </ul>
        <a
          class="text-muted dark:text-muted-dk hover:text-ink dark:hover:text-ink-dk mt-8 inline-block text-sm transition-colors"
          href="/blog"
        >
          All posts →
        </a>
      </section>
    )
  }

  <!-- The garden ships as a still image; this is the machinery behind the play
       button. Everything it touches — a 3MB fetch, several thousand SMIL
       elements, and the CSS keyframe motion that never settles on its own —
       happens only once someone has actually asked to see the tree grow. -->
  <script>
    const GROWN = 60; // seconds; comfortably past the longest growth animation.

    function controlGarden() {
      const object = document.getElementById("ccgarden");
      const poster = document.getElementById("ccgarden-poster");
      const play = document.getElementById("garden-play");
      const label = document.getElementById("garden-play-label");
      if (!(object instanceof HTMLObjectElement) || !(play instanceof HTMLButtonElement))
        return;

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      play.dataset.ready = "";
      if (label) label.textContent = reduced ? "Explore it" : "Watch it grow";

      // Owned by attach(), called by the click handler once the document is up.
      let replay: (() => void) | null = null;

      const reveal = () => {
        object.style.opacity = "1";
        object.classList.remove("pointer-events-none");
        if (poster) poster.style.opacity = "0";
        if (label) label.textContent = reduced ? "Explore it" : "Replay";
      };

      const attach = () => {
        // Duck-typed, and it has to be. `instanceof SVGSVGElement` is false
        // here: <object> is its own browsing context with its own realm, so
        // the root element is an instance of the *inner* window's constructor,
        // never this one's. That guard silently disabled everything below it.
        const svg = object.contentDocument?.documentElement as SVGSVGElement | undefined;
        if (typeof svg?.pauseAnimations !== "function") return;

        if (reduced) {
          // Jump to the end before pausing. Pausing at t=0 freezes the growth
          // animations before anything has grown — a blank patch of dirt. The
          // tooltips are the point of loading it at all in this mode.
          svg.setCurrentTime(GROWN);
          svg.pauseAnimations();
          reveal();
          return;
        }

        let onScreen = true;
        // The palette opens on top of the tree, so intersection alone still
        // leaves it repainting while someone is typing into it — and the
        // keystrokes lose the main thread to it.
        let paletteOpen = false;

        // pauseAnimations() only reaches SMIL. The idle motion — wind, the
        // star twinkle, the rain — is CSS keyframes, which needs its own
        // switch or it keeps running through both pauses below.
        // Namespaced: the SVG is a real XML document, and a null-namespace
        // <style> from createElement would parse but never apply.
        const halt = svg.ownerDocument.createElementNS(
          "http://www.w3.org/2000/svg",
          "style",
        );
        halt.textContent = "*{animation-play-state:paused !important}";

        const sync = () => {
          if (onScreen && !paletteOpen) {
            svg.unpauseAnimations();
            halt.remove();
          } else {
            svg.pauseAnimations();
            svg.append(halt);
          }
        };

        replay = () => {
          svg.setCurrentTime(0);
          onScreen = true;
          sync();
        };

        const observer = new IntersectionObserver(
          ([entry]) => {
            onScreen = entry.isIntersecting;
            sync();
          },
          { threshold: 0 },
        );
        observer.observe(object);

        const onPalette = (event: Event) => {
          paletteOpen = (event as CustomEvent<{ open: boolean }>).detail.open;
          sync();
        };
        document.addEventListener("palette:toggle", onPalette);

        document.addEventListener(
          "astro:before-swap",
          () => {
            observer.disconnect();
            document.removeEventListener("palette:toggle", onPalette);
          },
          { once: true },
        );

        svg.setCurrentTime(0);
        svg.unpauseAnimations();
        reveal();
      };

      play.addEventListener("click", () => {
        if (replay) {
          replay();
          return;
        }
        // Second click before it lands would start the fetch twice.
        if (object.data) return;

        if (label) label.textContent = "Loading…";
        object.addEventListener("load", attach, { once: true });
        // contentDocument is null until the SVG's own document finishes
        // parsing, and a bfcache restore replays no event — so try both paths.
        object.data = object.dataset.src ?? "";
        if (object.contentDocument?.readyState === "complete") attach();
      });
    }

    // Same rule the garden follows, for the same reason: the hero field and the
    // pipeline diagram loop forever, and a paged layout means each one spends
    // most of the visit scrolled off screen still repainting. CSS owns the
    // pause; this only marks who is visible.
    function controlFlow() {
      const flows = document.querySelectorAll<HTMLElement>("[data-flow]");
      if (!flows.length) return;

      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          const element = entry.target as HTMLElement;
          if (entry.isIntersecting) delete element.dataset.flowPaused;
          else element.dataset.flowPaused = "";
        }
      });

      for (const flow of flows) observer.observe(flow);
      document.addEventListener("astro:before-swap", () => observer.disconnect(), {
        once: true,
      });
    }

    document.addEventListener("astro:page-load", controlGarden);
    document.addEventListener("astro:page-load", controlFlow);
  </script>
</Layout>
