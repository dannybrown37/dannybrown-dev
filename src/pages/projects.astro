---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../lib/projects";
---

<Layout title="Projects">
  <h1 class="font-display text-3xl sm:text-4xl">Projects</h1>
  <p class="text-muted dark:text-muted-dk mt-4 max-w-prose text-lg">
    Things I build for myself and then keep using. Most of them started as a manual
    step I got tired of doing.
  </p>

  <ul class="mt-14 space-y-6">
    {projects.map((project) => <ProjectCard project={project} />)}
  </ul>
</Layout>
