---
import Layout from "../layouts/Layout.astro";

interface Project {
  name: string;
  description: string;
  url: string;
}

const projects: Project[] = [
  {
    name: "ccgarden",
    description:
      "Grows a tree from your Claude Code session history: trunk width tracks total sessions, branches are repos, leaves are sessions, flowers are cache-efficiency, clouds are models, bushes are tools. Zero dependencies, pure-stdlib Python generating self-contained animated SVG/SMIL.",
    url: "https://github.com/dannybrown37/ccgarden",
  },
  {
    name: "dotfiles",
    description: "Shell config, Claude Code skills/agents, and dev tooling.",
    url: "https://github.com/dannybrown37/dotfiles",
  },
];
---

<Layout title="Projects">
  <h1 class="text-2xl font-bold">Projects</h1>
  <ul class="mt-4 space-y-4">
    {
      projects.map((project) => (
        <li>
          <a class="font-medium underline" href={project.url}>
            {project.name}
          </a>
          <p class="text-sm text-gray-600 dark:text-gray-400">{project.description}</p>
        </li>
      ))
    }
  </ul>
</Layout>
