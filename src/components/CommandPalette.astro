---
import { secretTitles, type PaletteCommand } from "../lib/palette";

const visible: PaletteCommand[] = [
  {
    id: "home",
    title: "Home",
    keywords: ["about", "index", "start"],
    kind: "navigate",
    action: { type: "href", href: "/" },
  },
  {
    id: "experience",
    title: "Experience",
    keywords: ["resume", "cv", "work", "aws", "backend"],
    kind: "navigate",
    action: { type: "href", href: "/#experience-heading" },
  },
  {
    id: "garden",
    title: "Garden",
    keywords: ["visualization", "Claude Code", "projects", "svg", "art", "skill-tree"],
    kind: "navigate",
    action: { type: "href", href: "/#garden-heading" },
  },
  {
    id: "projects",
    title: "Projects",
    keywords: ["work", "code", "repos", "gtd", "ccgarden", "skill-tree", "dotfiles", "git-a-grip"],
    kind: "navigate",
    action: { type: "href", href: "/projects" },
  },
  {
    id: "writing",
    title: "Writing",
    keywords: ["blog", "posts", "articles"],
    kind: "navigate",
    action: { type: "href", href: "/blog" },
  },
  {
    id: "email",
    title: "Email Me",
    keywords: ["contact", "email", "reach out"],
    kind: "action",
    action: {
      type: "say",
      lines: ["Contact me:", "tinker@dannybrown.dev"],
    },
  },
  {
    id: "github",
    title: "GitHub",
    keywords: ["source", "code", "dannybrown37"],
    kind: "external",
    action: { type: "href", href: "https://github.com/dannybrown37", external: true },
  },
  {
    id: "linkedin",
    title: "LinkedIn",
    keywords: ["linkedin", "hire", "recruit", "dannybrown37"],
    kind: "external",
    action: { type: "href", href: "https://linkedin.com/in/dannybrown37", external: true },
  },
];

// `ls` is assembled from these below, so it can't be one of them.
const secrets: PaletteCommand[] = [
  {
    id: "git blame",
    title: "git blame",
    keywords: ["git", "blame", "who"],
    kind: "action",
    action: {
      type: "say",
      lines: ["f86753o9", "(Danny Brown 2026-08-11)", "it was me"],
    },
    secret: true,
  },
  {
    id: "git status",
    title: "git status",
    keywords: ["git", "status"],
    kind: "action",
    action: {
      type: "say",
      lines: ["On branch dannybrown.dev", "Your branch is up to date with 'origin/main'", "", "nothing to commit, working tree clean"],
    },
    secret: true,
  },
  {
    id: "man danny",
    title: "man danny",
    keywords: ["man", "danny", "manual", "help"],
    kind: "action",
    action: {
      type: "say",
      lines: [
        "NAME danny - senior software engineer",
        "SYNOPSIS danny [--python] [--node] [--aws] [--terraform]",
        "SEE ALSO uptime(1), whoami(1)",
      ],
    },
    secret: true,
  },
  {
    id: "pwd",
    title: "pwd",
    keywords: ["where", "pwd", "here"],
    kind: "action",
    action: {
      type: "say",
      lines: ["dannybrown.dev"],
    },
    secret: true,
  },
  {
    id: "rm -rf /",
    title: "rm -rf /",
    keywords: ["remove", "nuke", "bad"],
    kind: "action",
    action: {
      type: "say",
      lines: ["Permission denied. Nice try"],
    },
    secret: true,
  },
  {
    id: "uptime",
    title: "uptime",
    keywords: ["years", "experience", "how long"],
    kind: "action",
    action: { type: "say", lines: [
        "Since 2021 · connected vehicles · messages handled: billions",
        "2019 - 2021 · fundraising tech · dollars processed: millions",
        "2013 - 2021 · freelance content · articles written/edited: thousands",
        "2014 - 2019 · public service · cases investigated: hundreds",
      ]
    },
    secret: true,
  },
  {
    id: "whoami",
    title: "whoami",
    keywords: ["who", "identity"],
    kind: "action",
    action: {
      type: "say",
      lines: [
        "danny",
        "really loves the *craft* of software development",
        "always looking to automate the next thing",
        "supporter of fine arts",
        "spicy food enthusiast",
      ],
    },
    secret: true,
  },
];

// Serialized into the island below rather than rendered as markup: the list is
// rebuilt on every keystroke, so the client owns the DOM for it either way.
const commands: PaletteCommand[] = [
  ...visible,
  {
    id: "ls",
    title: "ls",
    keywords: ["list-directories", "what", "ls"],
    kind: "action",
    action: { type: "say", lines: secretTitles(secrets) },
    secret: true,
  },
  ...secrets,
];
---

<!-- hidden until the script promotes it: without JS the palette can't work at
     all, and an inert empty dialog in the tab order is worse than no dialog. -->
<dialog
  id="palette"
  aria-label="Command palette"
  class="bg-paper dark:bg-paper-dk text-ink dark:text-ink-dk border-line dark:border-line-dk m-0 hidden w-[min(32rem,calc(100vw-2rem))] rounded-xl border p-0 shadow-2xl backdrop:bg-black/40 backdrop:backdrop-blur-sm open:block"
  data-commands={JSON.stringify(commands)}
>
  <form method="dialog" class="contents">
    <div class="border-line dark:border-line-dk flex items-center gap-3 border-b px-4">
      <span class="text-muted dark:text-muted-dk font-mono text-sm" aria-hidden="true">
        &gt;
      </span>
      <input
        id="palette-input"
        type="text"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        placeholder="Jump to&hellip;"
        aria-controls="palette-list"
        aria-expanded="true"
        aria-autocomplete="list"
        role="combobox"
        class="placeholder:text-muted dark:placeholder:text-muted-dk w-full bg-transparent py-3.5 font-sans text-base outline-none"
      />
    </div>

    <p
      id="palette-say"
      hidden
      class="border-line dark:border-line-dk text-muted dark:text-muted-dk border-b px-4 py-3 font-mono text-xs leading-relaxed whitespace-pre-line"
      role="status"
    >
    </p>

    <ul id="palette-list" role="listbox" aria-label="Commands" class="max-h-80 overflow-y-auto p-2">
    </ul>

    <div
      class="border-line dark:border-line-dk text-muted dark:text-muted-dk hidden items-center gap-4 border-t px-4 py-2.5 font-mono text-[0.7rem] sm:flex"
    >
      <span><kbd>&uarr;</kbd><kbd>&darr;</kbd> navigate</span>
      <span><kbd>&crarr;</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>

    <!-- Same row for the keyboard-less: the hidden commands are the reason to
         open this at all, and `ls` is the only way to find them by tapping. -->
    <div
      class="border-line dark:border-line-dk text-muted dark:text-muted-dk flex items-center gap-4 border-t px-4 py-2.5 font-mono text-[0.7rem] sm:hidden"
    >
      <span>tap to run</span>
      <span>type <span class="text-accent dark:text-accent-dk">ls</span> for more</span>
    </div>
  </form>
</dialog>

<style>
  /* Scoped here rather than in global.css: kbd only appears in this footer. */
  kbd {
    font: inherit;
  }
</style>

<script>
  import { filterCommands, nextIndex, type PaletteCommand } from "../lib/palette";

  function setupPalette() {
    const dialog = document.getElementById("palette");
    const input = document.getElementById("palette-input");
    const list = document.getElementById("palette-list");
    const say = document.getElementById("palette-say");
    const trigger = document.getElementById("palette-trigger");
    if (
      !(dialog instanceof HTMLDialogElement) ||
      !(input instanceof HTMLInputElement) ||
      !(list instanceof HTMLUListElement) ||
      !(say instanceof HTMLParagraphElement)
    ) {
      return;
    }

    const commands: PaletteCommand[] = JSON.parse(dialog.dataset.commands ?? "[]");
    let shown: PaletteCommand[] = [];
    let active = 0;

    // The markup ships hidden so a no-JS visitor gets no dead affordance; this
    // is the point where the palette is known to work.
    dialog.classList.remove("hidden");
    if (trigger) trigger.dataset.ready = "";

    // Built once and reordered on each filter. Recreating them per keystroke
    // meant re-parsing these class strings on every character typed.
    const nodes = new Map<string, HTMLLIElement>(
      commands.map((command) => {
        const item = document.createElement("li");
        item.id = `palette-item-${command.id}`;
        item.role = "option";
        item.className =
          "flex cursor-pointer items-center gap-3 rounded-md px-3 py-2 text-sm aria-selected:bg-accent/10 dark:aria-selected:bg-accent-dk/15 aria-selected:text-accent dark:aria-selected:text-accent-dk";

        const icon = document.createElement("span");
        icon.className = "text-muted dark:text-muted-dk w-3 font-mono text-xs";
        icon.ariaHidden = "true";
        icon.textContent =
          command.kind === "external" ? "↗" : command.kind === "action" ? "⌥" : "→";

        const label = document.createElement("span");
        label.textContent = command.title;
        if (command.secret) label.className = "font-mono";

        item.append(icon, label);
        return [command.id, item];
      }),
    );

    const empty = document.createElement("li");
    empty.className = "text-muted dark:text-muted-dk px-3 py-2 text-sm";
    empty.textContent = "No matches.";

    let items: HTMLLIElement[] = [];

    const render = () => {
      shown = filterCommands(commands, input.value);
      if (active >= shown.length) active = 0;

      items = shown.map((command, index) => {
        const item = nodes.get(command.id)!;
        item.dataset.index = String(index);
        return item;
      });

      list.replaceChildren(...(items.length ? items : [empty]));
      syncActive();
    };

    const syncActive = () => {
      items.forEach((item, index) => {
        item.ariaSelected = String(index === active);
      });
      const current = items[active];
      input.setAttribute("aria-activedescendant", current?.id ?? "");
      // `scroll-behavior: smooth` on <html> is inherited here, and an animated
      // scroll per keystroke is what made typing feel laggy.
      current?.scrollIntoView({ block: "nearest", behavior: "instant" });
    };

    // Anything expensive on the page behind the palette (the ccgarden SMIL
    // animation) pauses on this rather than the palette reaching for it.
    const announce = (open: boolean) =>
      document.dispatchEvent(new CustomEvent("palette:toggle", { detail: { open } }));

    const open = () => {
      if (dialog.open) return;
      input.value = "";
      active = 0;
      say.hidden = true;
      render();
      dialog.showModal();
      // showModal() focuses the input, which on touch raises the virtual
      // keyboard over the list you opened this to browse. Tapping the input
      // still brings it up when you actually want to type.
      if (!matchMedia("(hover: hover)").matches) input.blur();
      announce(true);
    };

    dialog.addEventListener("close", () => announce(false));

    const run = (command: PaletteCommand | undefined) => {
      if (!command) return;
      const action = command.action;

      if (action.type === "say") {
        // Stays open: the output is the whole point of these. Clearing the
        // query the way a shell clears its line leaves the output up while the
        // list resets, so the next command is a fresh prompt rather than an
        // edit of the last one.
        say.textContent = action.lines.join("\n");
        say.hidden = false;
        input.value = "";
        active = 0;
        render();
        return;
      }

      dialog.close();

      if (action.external) {
        window.open(action.href, "_blank", "noopener");
      } else {
        // Astro's router picks this up and swaps, same as a nav click.
        window.location.href = action.href;
      }
    };

    input.addEventListener("input", () => {
      say.hidden = true;
      active = 0;
      render();
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        active = nextIndex(active, shown.length, event.key === "ArrowDown" ? 1 : -1);
        syncActive();
      } else if (event.key === "Enter") {
        // The dialog's form would close on Enter before the handler runs.
        event.preventDefault();
        run(shown[active]);
      }
    });

    list.addEventListener("click", (event) => {
      const item = (event.target as Element).closest<HTMLLIElement>("[data-index]");
      if (item) run(shown[Number(item.dataset.index)]);
    });

    list.addEventListener("pointermove", (event) => {
      const item = (event.target as Element).closest<HTMLLIElement>("[data-index]");
      const index = Number(item?.dataset.index);
      if (item && index !== active) {
        active = index;
        syncActive();
      }
    });

    // Clicking the backdrop lands on the dialog itself, never on its children.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    trigger?.addEventListener("click", open);

    const onKeydown = (event: KeyboardEvent) => {
      const target = event.target as HTMLElement | null;
      const typing =
        target?.isContentEditable ||
        ["INPUT", "TEXTAREA", "SELECT"].includes(target?.tagName ?? "");

      if (event.key === "k" && (event.metaKey || event.ctrlKey)) {
        event.preventDefault();
        dialog.open ? dialog.close() : open();
      } else if (event.key === "/" && !typing && !dialog.open) {
        // Otherwise the "/" that opened it becomes the first character typed.
        event.preventDefault();
        open();
      }
    };

    document.addEventListener("keydown", onKeydown);
    // ClientRouter keeps the document across navigations, so without this the
    // listeners stack up one set per page visited.
    document.addEventListener(
      "astro:before-swap",
      () => document.removeEventListener("keydown", onKeydown),
      { once: true },
    );
  }

  document.addEventListener("astro:page-load", setupPalette);
</script>
